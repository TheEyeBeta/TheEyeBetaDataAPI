ENVIRONMENT=production
DEBUG=false

DATABASE_URL=postgresql+psycopg://api_readonly:REPLACE_ME@127.0.0.1:5432/theeyebeta
# DataAPI-issued JWT signing (service + delegated). CURRENT signs; PREVIOUS verifies only.
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_JWT_SECRET_MIN_24_CHARS
JWT_SIGNING_SECRET_CURRENT=
JWT_SIGNING_SECRET_PREVIOUS=
JWT_ALGORITHM=HS256
JWT_ISSUER=theeyebeta-dataapi
JWT_AUDIENCE=theeyebeta-clients
USER_JWT_SECRET=REPLACE_WITH_USER_JWT_SECRET_MIN_24_CHARS
USER_JWT_SECRET_PREVIOUS=
USER_JWT_ALGORITHM=HS256
USER_JWT_JWKS_URL=
USER_JWT_ISSUER=
USER_JWT_AUDIENCE=
USER_JWT_ALGORITHMS=RS256
SERVICE_TOKEN_EXPIRES_MINUTES=60
DELEGATED_TOKEN_EXPIRES_MINUTES=5
# When true, every JWT decode requires iss+aud. Keep false until IAM inventory
# confirms no legacy tokens lack these claims (see docs/IAM_CONSUMER_INVENTORY.md).
JWT_REQUIRE_ISS_AUD=false
# Phase 3: opted-in service clients (iam.service_clients.short_lived_tokens_enabled)
# receive this access-token TTL plus a refresh token from /api/v1/auth/service-token.
SHORT_LIVED_ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_EXPIRES_DAYS=30
USER_API_KEY_MAX_EXPIRES_DAYS=365
USER_API_KEY_BACKFILL_DAYS=180
SERVICE_CLIENT_AUTH_MODE=database
# Only read when SERVICE_CLIENT_AUTH_MODE is environment/hybrid; database mode uses iam.* tables.
SERVICE_CLIENTS_JSON={"example-reader":{"secret":"REPLACE_WITH_CLIENT_SECRET_MIN_24_CHARS","scopes":["market:read","symbols:read","analytics:read","signals:read"]},"example-admin":{"secret":"REPLACE_WITH_ADMIN_SECRET_MIN_24_CHARS","scopes":["admin:read"]}}
SERVICE_MTLS_ENABLED=false
SERVICE_MTLS_SUBJECTS_JSON={}
SERVICE_MTLS_HEADER_CLIENT_ID=X-Service-Client-Id
SERVICE_MTLS_HEADER_SUBJECT=X-Client-Cert-Subject

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

API_HOST=127.0.0.1
API_PORT=7000
GUNICORN_WORKERS=2

# Comma-separated browser origin allowlist. No wildcard in production.
CORS_ORIGINS=https://admin.theeyebeta.store,http://tauri.localhost,https://tauri.localhost,tauri://localhost
# Comma-separated Host header allowlist.
TRUSTED_HOSTS=api.theeyebeta.store,dataapi.theeyebeta.store,dataapiprod.theeyebeta.store,127.0.0.1,localhost
# Enable when running behind Cloudflare Tunnel or trusted reverse proxy.
TRUST_PROXY_HEADERS=true

RATE_LIMIT_PER_MINUTE=120
REDIS_URL=
RATE_LIMIT_REDIS_PREFIX=dataapi:ratelimit

# Operator code word required by DELETE /api/v1/admin/accounts/{user_uuid}.
# Leave unset to fail closed (account deactivation always rejected with 403).
# Set only in the local operator environment / host-local env file — never commit a value here.
ADMIN_ACCOUNT_APPROVAL_CODE=

# Requires the theeyebeta.dataapi_* policy tables (created by TheEyeBetaProd migration 0092,
# since TheEyeBetaProd owns the theeyebeta schema) with policy records seeded. Must be true in production.
POLICY_ENFORCEMENT_ENABLED=true
# The DataAPI origin is the sole remote administrative entry point. This target must remain loopback.
ADMIN_GATEWAY_ENABLED=true
ADMIN_SERVICE_URL=http://127.0.0.1:7200
ADMIN_GATEWAY_TIMEOUT_SECONDS=30
ADMIN_GATEWAY_MAX_BODY_BYTES=1048576

# docker-compose monitoring stack only (compose refuses to start without it).
GRAFANA_ADMIN_PASSWORD=
