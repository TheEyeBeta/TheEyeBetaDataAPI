{
  "name": "dataapi-frontend",
  "version": "1.0.0",
  "description": "Simple frontend + proxy to exercise TheEyeBetaDataAPI safely",
  "type": "module",
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "tsc -p tsconfig.client.json",
    "start": "npm run build && node dist/server.js",
    "start:fast": "node dist/server.js"
  },
  "dependencies": {
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "typescript": "^5.7.2"
  }
}
